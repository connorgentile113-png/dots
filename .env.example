# Never put real secrets in this tracked file.
PORT=8000
FIREBASE_PROJECT_ID=dots-300de
FIREBASE_SERVICE_ACCOUNT_JSON=
NVIDIA_API_KEY=
# Explicitly list hosted model IDs accessible to your account.
NVIDIA_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,deepseek-ai/deepseek-v4.1-flash,z-ai/glm-5.3-flash
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
BROWSERLESS_TOKEN=
BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io
# Set to the actual free monthly allowance from your account; 0 disables.
BROWSERLESS_MONTHLY_UNITS=0
BROWSERLESS_UNIT_SECONDS=30
BROWSERLESS_SESSION_SECONDS=60
GITHUB_TOKEN=
GITHUB_REPOSITORY=connorgentile113-png/dots
GITHUB_COMMAND_WORKFLOW=agent-command.yml
GITHUB_WAKE_SECRET=
PUBLIC_BACKEND_URL=
BACKUP_KEY_BASE64=
# Explicit opt-in; backend verifies the repository is private.
GITHUB_BACKUP_ENABLED=false
MAX_ACTIVE_RUNS=1
MAX_RUN_STEPS=16
DAILY_MODEL_CALLS=100
# Account must be enabled by operator; never enable all signups automatically.
ALLOWED_USER_UIDS=
# Auto-enable only this owner after Firebase confirms email verification.
OWNER_EMAIL=
