rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /commands/{id} {
      allow create: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enabled == true
        && request.resource.data.keys().hasOnly(['uid','kind','payload','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.payload is map
        && request.resource.data.kind in ['start','cancel','resume','save_dot','delete_dot','schedule','pause_schedule','delete_memory','approve','heartbeat'];
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
      match /{collection}/{id} {
        allow read: if signedIn() && request.auth.uid == uid
          && collection in ['dots','runs','messages','schedules','memories','approvals','usage','connections','streams'];
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
